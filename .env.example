# Copy this file to .env.local in the project root, fill in values, then restart `npm run dev`.
# Never commit .env.local — it is gitignored.

# Public site URL (Open Graph / canonical). Optional locally; set in production.
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Supabase — auth, Postgres, Storage (projects, files, analysis, chat). Optional for /demo only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox — map rendering + geocoding + directions + isochrone + tilequery (public token)
NEXT_PUBLIC_MAPBOX_TOKEN=

# OpenAI — structured analysis, planning brief, scenario comparison, chat (server only — never NEXT_PUBLIC_)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=dall-e-3

# Optional: Overpass API base (default: overpass-api.de)
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Optional: Created upstream for generic chat (project chat adds system context server-side)
# CREATED_CHAT_API_URL=https://chat-z.created.app/api/chat

# Server-only: for admin scripts or service operations bypassing RLS (keep secret)
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: max upload bytes for project file registration (default 15MB)
# MAX_UPLOAD_BYTES=15728640

# Optional: feature flags or internal JSON (future use)
# FEATURE_FLAGS=

# Optional: Referer for AUB ICIL ArcGIS MapServer (defaults to Beirut Urban Lab hub URL)
# BEIRUT_URBAN_LAB_REFERER=https://beirut-urban-lab-open-data-platform-aub.hub.arcgis.com/
